# ---- Server ----
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# ---- Secrets (generate your own random strings for each) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replaceWithRandomString
ADMIN_JWT_SECRET=replaceWithRandomString
TRANSFER_TOKEN_SALT=replaceWithRandomString
JWT_SECRET=replaceWithRandomString
ENCRYPTION_KEY=replaceWithRandomString

# ---- Database ----
# Local development (default): sqlite, no extra config needed.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production on Railway: switch to postgres and use the DATABASE_URL
# Railway gives you when you add a PostgreSQL plugin to your project.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:port/dbname
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
